<style>
    /* A single horizontal rail. The scrollbar is hidden because the arrows and
       drag already move it, and it would otherwise sit under the cards. */
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }

    /* A plain white tile that lifts a little on hover. There is no perpetual
       movement: the rail is where the eye should be, not the cards. */
    .category-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }
    .category-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px -12px rgba(16, 185, 129, 0.45);
        border-color: #34d399;
    }
</style>

<section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
        <div class="flex justify-between items-end mb-8 px-2">
            <div>
                <span class="text-green-600 font-bold tracking-widest uppercase text-xs">Explore</span>
                <h2 class="text-3xl md:text-4xl font-black text-gray-800 mt-1">
                    Top <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-500 to-teal-500">Categories</span>
                </h2>
            </div>

            <div class="hidden md:flex gap-2">
                <button type="button" onclick="scrollCategories('left')" aria-label="Scroll categories left" class="w-10 h-10 rounded-full bg-white border border-gray-200 shadow-sm text-gray-600 hover:text-green-600 hover:border-green-300 transition-colors flex items-center justify-center">
                    <i class="fas fa-chevron-left" aria-hidden="true"></i>
                </button>
                <button type="button" onclick="scrollCategories('right')" aria-label="Scroll categories right" class="w-10 h-10 rounded-full bg-white border border-gray-200 shadow-sm text-gray-600 hover:text-green-600 hover:border-green-300 transition-colors flex items-center justify-center">
                    <i class="fas fa-chevron-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div id="categoryScroll" role="region" aria-label="Featured categories" class="flex overflow-x-auto hide-scrollbar pb-6 pt-2 px-2 gap-6 snap-x snap-mandatory scroll-smooth">

            <% if(locals.categories && categories.length > 0) { %>
                <% categories.forEach((category) => { %>
                    <a href="/user/category/<%= category.id %>" class="flex-shrink-0 snap-center">
                        <div class="category-card bg-white rounded-2xl border border-gray-100 shadow-sm w-48 h-64 md:w-56 md:h-72 flex flex-col items-center justify-between p-6">
                            <div class="w-full h-32 md:h-40 rounded-xl bg-gray-50 flex items-center justify-center overflow-hidden">
                                <img
                                    src="<%= category.image %>"
                                    alt="<%= category.name %>"
                                    class="w-3/4 h-3/4 object-contain"
                                    loading="lazy"
                                >
                            </div>

                            <div class="text-center w-full">
                                <h3 class="text-lg font-bold text-gray-800 truncate">
                                    <%= category.name %>
                                </h3>
                                <span class="inline-block mt-2 text-xs font-medium text-gray-500">
                                    <%= category.items %> Items
                                </span>
                            </div>
                        </div>
                    </a>
                <% }); %>

                <a href="/categories/all" class="flex-shrink-0 snap-center">
                    <div class="category-card bg-white rounded-2xl border-2 border-dashed border-gray-200 w-48 h-64 md:w-56 md:h-72 flex flex-col items-center justify-center p-6">
                        <div class="w-16 h-16 rounded-full bg-green-50 text-green-500 flex items-center justify-center mb-4">
                            <i class="fas fa-th-large text-2xl" aria-hidden="true"></i>
                        </div>
                        <h3 class="text-lg font-bold text-gray-700">View All</h3>
                        <p class="text-sm text-gray-400 mt-1">Discover More</p>
                    </div>
                </a>

            <% } else { %>
                <div class="w-full text-center py-10">
                    <p class="text-gray-500">No categories found right now.</p>
                </div>
            <% } %>

        </div>
    </div>
</section>

<script>
    const categoryScroll = document.getElementById('categoryScroll');

    // The arrows move the rail one card at a time. scrollBy keeps the CSS
    // scroll-smooth behaviour, so the movement eases instead of jumping.
    function scrollCategories(direction) {
        if (!categoryScroll) return;
        categoryScroll.scrollBy({
            left: direction === 'left' ? -300 : 300,
            behavior: 'smooth',
        });
    }

    // Drag to scroll, for a mouse. Touch already scrolls natively.
    if (categoryScroll) {
        let isDown = false;
        let startX = 0;
        let startScroll = 0;

        categoryScroll.addEventListener('mousedown', (e) => {
            isDown = true;
            startX = e.pageX;
            startScroll = categoryScroll.scrollLeft;
            categoryScroll.classList.add('cursor-grabbing');
        });
        const endDrag = () => {
            isDown = false;
            categoryScroll.classList.remove('cursor-grabbing');
        };
        categoryScroll.addEventListener('mouseleave', endDrag);
        categoryScroll.addEventListener('mouseup', endDrag);
        categoryScroll.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            categoryScroll.scrollLeft = startScroll - (e.pageX - startX);
        });
    }
</script>
