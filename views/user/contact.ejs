<%- include("./header") %>

<main class="container mx-auto px-4 py-10 max-w-4xl">
    <header class="text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Contact</p>
        <h1 class="mt-3 text-4xl font-bold text-gray-900">Talk to ToyHub</h1>
        <p class="mt-4 text-gray-600">
            A question about a product, an order or a return? Send a message and we will get back to you.
        </p>
    </header>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
        <a href="mailto:toyhub@gmail.com" class="group bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:border-green-300 transition-colors">
            <div class="flex items-start gap-4">
                <span class="w-11 h-11 rounded-full bg-green-50 text-primary flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-envelope" aria-hidden="true"></i>
                </span>
                <span>
                    <span class="block text-lg font-semibold text-gray-900 group-hover:text-primary">Email</span>
                    <span class="block mt-1 text-gray-600">toyhub@gmail.com</span>
                    <span class="block mt-2 text-sm text-gray-500">Best for order details and returns.</span>
                </span>
            </div>
        </a>

        <a href="tel:+916238880997" class="group bg-white rounded-xl shadow-sm border border-gray-100 p-6 hover:border-green-300 transition-colors">
            <div class="flex items-start gap-4">
                <span class="w-11 h-11 rounded-full bg-green-50 text-primary flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-phone" aria-hidden="true"></i>
                </span>
                <span>
                    <span class="block text-lg font-semibold text-gray-900 group-hover:text-primary">Phone</span>
                    <span class="block mt-1 text-gray-600">(+91) 6238880997</span>
                    <span class="block mt-2 text-sm text-gray-500">For quick questions during shop hours.</span>
                </span>
            </div>
        </a>
    </div>

    <section class="mt-8 bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-lg font-semibold text-gray-900">Already ordered?</h2>
        <p class="mt-2 text-gray-600">
            Your order status, invoice and cancellation options live in your account. Have the order number ready.
        </p>
        <a href="/account/orders" class="mt-4 inline-flex items-center gap-2 text-primary font-semibold hover:text-green-700">
            Go to your orders <i class="fas fa-arrow-right" aria-hidden="true"></i>
        </a>
    </section>
</main>

<%- include("./footer") %>
